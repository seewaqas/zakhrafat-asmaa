---
import type { Faq } from "../data/site.ts";

interface Props {
  heading: string;
  items: readonly Faq[];
}

const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section">
      <h2>{heading}</h2>
      <div class="faq">
        {items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
