---
import AlphabetTable from "./AlphabetTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlankList from "./BlankList.astro";
import FaqList from "./FaqList.astro";
import Generator from "./Generator.astro";
import HomeBands from "./HomeBands.astro";
import NameList from "./NameList.astro";
import SymbolGrid from "./SymbolGrid.astro";
import UsernameTool from "./UsernameTool.astro";
import { hrefFor, UI, type PageDef } from "../data/site.ts";
import { getPage } from "../data/pages.ts";
import { jsonLdScript, pageGraph } from "../lib/seo.ts";
import type { Locale } from "../lib/styles.ts";

interface Props {
  page: PageDef;
  locale: Locale;
}

const { page, locale } = Astro.props;
const copy = page[locale];
const ui = UI[locale];
const origin = Astro.site?.origin;
const pageUrl = origin ? new URL(hrefFor(page.slug, locale), origin).href : undefined;
const homeUrl = origin ? new URL(hrefFor("", locale), origin).href : undefined;
const crumbs = page.slug
  ? [
      { name: ui.home, url: homeUrl },
      { name: copy.h1, url: pageUrl },
    ]
  : [{ name: ui.home, url: homeUrl }];
const jsonLd = jsonLdScript(
  pageGraph({
    name: copy.h1,
    description: copy.description,
    locale,
    url: pageUrl,
    faq: copy.faq,
    crumbs,
  }),
);
const limitHint = locale === "ar" ? page.limitHintAr : page.limitHintEn;
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} slug={page.slug} jsonLd={jsonLd}>
  <article class="wrap">
    <header class="hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.h1}</h1>
    </header>
    {page.tool === "generator" && (
      <Generator
        locale={locale}
        sample={page.sample}
        category={page.category}
        phrases={page.phrases}
        limit={page.limit}
        limitHint={limitHint}
        stripTashkeel={page.stripTashkeel}
      />
    )}
    {page.tool === "blanks" && <BlankList locale={locale} />}
    {page.tool === "usernames" && <UsernameTool locale={locale} sample={page.sample} />}
    {copy.lede.map((paragraph) => <p class="lede after">{paragraph}</p>)}
    {page.home && <HomeBands locale={locale} />}
    {page.names && <NameList locale={locale} group={page.names} />}
    {page.symbols && <SymbolGrid locale={locale} />}
    {page.alphabet && <AlphabetTable locale={locale} />}
    {copy.steps.length > 0 && (
      <section class="section">
        <h2>{ui.how}</h2>
        <ol class="steps">
          {copy.steps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    )}
    {copy.sections.map((section) => (
      <section class="section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}
    <FaqList heading={locale === "ar" ? "الأسئلة الشائعة" : "FAQ"} items={copy.faq} />
    {page.related.length > 0 && (
      <section class="section">
        <h2>{ui.related}</h2>
        <div class="link-row">
          {page.related.map((slug) => {
            const related = getPage(slug);
            if (!related) return null;
            return <a class="text-link" href={hrefFor(slug, locale)}>{related[locale].h1}</a>;
          })}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
