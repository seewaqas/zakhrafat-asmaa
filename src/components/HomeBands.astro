---
import { hrefFor } from "../data/site.ts";
import { UI } from "../data/site.ts";
import { getStyle } from "../lib/styles.ts";
import type { Locale } from "../lib/styles.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const popular = [
  ["pubg-names", locale === "ar" ? "زخرفة اسماء ببجي" : "PUBG"],
  ["free-fire-names", locale === "ar" ? "فري فاير" : "Free Fire"],
  ["facebook-names", locale === "ar" ? "فيسبوك" : "Facebook"],
  ["tiktok-names", locale === "ar" ? "تيك توك" : "TikTok"],
  ["instagram-names", locale === "ar" ? "انستقرام" : "Instagram"],
  ["names-with-symbols", locale === "ar" ? "رموز" : "Symbols"],
  ["name-font-styles", locale === "ar" ? "خط صغير" : "Small type"],
  ["iphone-names", locale === "ar" ? "آيفون" : "iPhone"],
] as const;
const featured = ["bold", "script", "fraktur", "tatweel", "lenticular"] as const;
const games = [
  ["pubg-names", "ببجي"],
  ["free-fire-names", "فري فاير"],
  ["game-names", locale === "ar" ? "فورت نايت وغيرها" : "Fortnite and others"],
] as const;
const social = [
  ["instagram-names", locale === "ar" ? "انستقرام" : "Instagram"],
  ["tiktok-names", locale === "ar" ? "تيك توك" : "TikTok"],
  ["social-chat-names", locale === "ar" ? "واتساب" : "WhatsApp"],
] as const;
const tools = [
  ["name-font-styles", locale === "ar" ? "الخطوط" : "Fonts"],
  ["names-with-symbols", locale === "ar" ? "الرموز" : "Symbols"],
  ["hidden-characters", locale === "ar" ? "أحرف مخفية" : "Hidden characters"],
] as const;
---

<section class="section">
  <h2>{ui.popular}</h2>
  <div class="link-row">
    {popular.map(([slug, label]) => <a class="text-link" href={hrefFor(slug, locale)}>{label}</a>)}
  </div>
</section>
<section class="section">
  <h2>{ui.featured}</h2>
  <ul class="feature-list">
    {featured.map((id) => {
      const style = getStyle(id);
      if (!style) return null;
      const sample = id === "tatweel" || id === "lenticular" ? "نور" : "Nora";
      return (
        <li>
          <span>{locale === "ar" ? style.nameAr : style.nameEn}</span>
          <bdi dir="auto">{style.apply(sample)}</bdi>
        </li>
      );
    })}
  </ul>
</section>
<section class="section">
  <h2>{ui.gamesTitle}</h2>
  <div class="link-row">
    {games.map(([slug, label]) => <a class="text-link" href={hrefFor(slug, locale)}>{label}</a>)}
  </div>
</section>
<section class="section">
  <h2>{ui.socialTitle}</h2>
  <div class="link-row">
    {social.map(([slug, label]) => <a class="text-link" href={hrefFor(slug, locale)}>{label}</a>)}
  </div>
</section>
<section class="section">
  <h2>{ui.toolsTitle}</h2>
  <div class="link-row">
    {tools.map(([slug, label]) => <a class="text-link" href={hrefFor(slug, locale)}>{label}</a>)}
  </div>
</section>
